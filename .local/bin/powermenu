#!/usr/bin/env bash

lock="󰌾 Lock"
suspend="󰤄 Sleep"
logout="󰍃 Logout"
reboot="󰜉 Reboot"
shutdown="󰐥 Shutdown"

options="$lock\n$suspend\n$logout\n$reboot\n$shutdown"

chosen=$(echo -e "$options" | rofi -dmenu \
    -p "Питание" \
    -theme-str 'window {width: 250px; border-radius: 16px;} listview {lines: 5;}')

case $chosen in
    $lock)
        hyprlock
        ;;
    $suspend)
        systemctl suspend && hyprlock
        ;;
    $logout)
        hyprctl dispatch exit
        ;;
    $reboot)
        systemctl reboot
        ;;
    $shutdown)
        systemctl poweroff
        ;;
esac