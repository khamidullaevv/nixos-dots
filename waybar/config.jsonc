{
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 0,

  "modules-left": [
    "custom/distro",
    "hyprland/workspaces",
    "hyprland/window"
  ],

  "modules-center": [
    "custom/cava",
    "clock"
  ],

  "modules-right": [
    "cpu",
    "memory",
    "temperature",
    "network",
    "pulseaudio",
    "battery",
    "tray"
  ],

  "custom/distro": {
    "format": "",
    "tooltip": true,
    "tooltip-format": "NixOS"
  },

  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "active": "●",
      "default": "○",
      "empty": "·",
      "urgent": "!"
    },

    "on-click": "activate",

    "persistent-workspaces": {
      "*": 5
    }
  },

  "hyprland/window": {
    "format": "{title}",
    "max-length": 50,
    "separate-outputs": true
  },

  "custom/cava": {
    "exec": "~/.config/waybar/scripts/cava.sh",
    "format": "{}",
    "tooltip": false
  },

  "clock": {
    "format": "  {:%H:%M}",
    "format-alt": "  {:%A, %d %B %Y}",
    "tooltip-format": "<tt>{calendar}</tt>"
  },

  "cpu": {
    "format": "󰻠  {usage}%",
    "interval": 2,
    "tooltip": true,
    "on-click": "kitty -e btop"
  },

  "memory": {
    "format": "󰍛  {percentage}%",
    "interval": 5,
    "tooltip-format": "RAM: {used:0.1f}G / {total:0.1f}G"
  },

  "temperature": {
    "thermal-zone": 0,
    "critical-threshold": 80,

    "format": "  {temperatureC}°C",
    "format-critical": "  {temperatureC}°C",

    "tooltip-format": "CPU temperature: {temperatureC}°C"
  },

  "network": {
    "format-wifi": "󰤨  {signalStrength}%",
    "format-ethernet": "󰈀  {ipaddr}",
    "format-disconnected": "󰤭  offline",

    "tooltip-format-wifi": "{essid}\n{ipaddr}\nSignal: {signalStrength}%",
    "tooltip-format-ethernet": "{ifname}\n{ipaddr}",

    "on-click": "kitty -e nmtui"
  },

  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "󰝟  muted",

    "format-icons": {
      "default": [
        "",
        "",
        ""
      ]
    },

    "on-click": "pavucontrol",

    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",

    "scroll-step": 5
  },

  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },

    "format": "{icon}  {capacity}%",
    "format-charging": "󰂄  {capacity}%",

    "format-icons": [
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ]
  },

  "tray": {
    "spacing": 8,
    "icon-size": 16
  }
}