[global]
    monitor = 0
    follow = mouse

    width = 380
    height = (0, 180)

    origin = top-right
    offset = (18, 55)

    notification_limit = 5

    transparency = 8

    frame_width = 2
    frame_color = "#ffb3af"

    separator_height = 1
    separator_color = "#a08c8b"

    padding = 14
    horizontal_padding = 16
    text_icon_padding = 12

    corner_radius = 18

    font = JetBrainsMono Nerd Font 10

    markup = full
    format = "<b>%s</b>\n%b"

    alignment = left
    vertical_alignment = center

    show_indicators = yes

    icon_position = left
    min_icon_size = 42
    max_icon_size = 56

    icon_theme = Papirus-Dark

    stack_duplicates = true
    hide_duplicate_count = true

    mouse_left_click = close_current
    mouse_middle_click = do_action
    mouse_right_click = close_all

    idle_threshold = 120


[urgency_low]
    timeout = 4
    background = "#231919"
    foreground = "#f0dedd"
    frame_color = "#ffb3af"
    default_icon = dialog-information


[urgency_normal]
    timeout = 6
    background = "#271d1d"
    foreground = "#f0dedd"
    frame_color = "#ffb3af"
    default_icon = dialog-information


[urgency_critical]
    timeout = 0
    background = "#93000a"
    foreground = "#ffdad6"
    frame_color = "#ffb4ab"
    default_icon = dialog-warning
