configuration {
    modi: "drun,run,window";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    font: "JetBrainsMono Nerd Font Bold 11";
    display-drun: "󰍉 ";
    display-run: "󰅂 ";
    display-window: "󱂬 ";
    drun-display-format: "{name}";
}

* {
    /* Catppuccin Mocha Palette */
    bg-base:     #1e1e2e;
    bg-surface:  #181825;
    bg-mantle:   #11111b;
    fg-main:     #cdd6f4;
    fg-sub:      #a6adc8;
    accent:      #cba6f7;
    accent-sec:  #89b4fa;
    
    background-color: transparent;
    text-color:       @fg-main;
}

window {
    width:            620px;
    background-color: @bg-base;
    border:           2px;
    border-color:     @accent;
    border-radius:    12px;
    padding:          0px;
}

mainbox {
    padding:  16px;
    spacing:  12px;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @bg-surface;
    border:           1px;
    border-color:     #313244;
    border-radius:    8px;
    padding:          10px 14px;
    spacing:          10px;
    children:         [ prompt, entry ];
}

prompt {
    text-color: @accent;
    font:       "JetBrainsMono Nerd Font Bold 12";
}

entry {
    placeholder:       "Поиск...";
    placeholder-color: @fg-sub;
    text-color:        @fg-main;
}

listview {
    lines:        7;
    columns:      1;
    spacing:      6px;
    scrollbar:    false;
    fixed-height: false;
}

element {
    padding:          8px 12px;
    border-radius:    8px;
    spacing:          12px;
    background-color: transparent;
}

element-icon {
    size:             24px;
    vertical-align:   0.5;
}

element-text {
    vertical-align:   0.5;
    text-color:       inherit;
}

element normal.normal {
    background-color: transparent;
    text-color:        @fg-main;
}

element alternate.normal {
    background-color: transparent;
    text-color:        @fg-main;
}

element selected.normal {
    background-color: @accent;
    text-color:        @bg-mantle;
}

element selected.normal element-text {
    text-color: @bg-mantle;
}

element selected.normal element-icon {
    text-color: @bg-mantle;
}