[global]
    monitor = 0
    follow = mouse

    width = 380
    height = (0, 180)

    origin = top-right
    offset = (18, 55)

    notification_limit = 5

    transparency = 8

    frame_width = 2
    frame_color = "{{colors.primary.default.hex}}"

    separator_height = 1
    separator_color = "{{colors.outline.default.hex}}"

    padding = 14
    horizontal_padding = 16
    text_icon_padding = 12

    corner_radius = 18

    font = JetBrainsMono Nerd Font 10

    markup = full
    format = "<b>%s</b>\n%b"

    alignment = left
    vertical_alignment = center

    show_indicators = yes

    icon_position = left
    min_icon_size = 42
    max_icon_size = 56

    icon_theme = Papirus-Dark

    stack_duplicates = true
    hide_duplicate_count = true

    mouse_left_click = close_current
    mouse_middle_click = do_action
    mouse_right_click = close_all

    idle_threshold = 120


[urgency_low]
    timeout = 4
    background = "{{colors.surface_container_low.default.hex}}"
    foreground = "{{colors.on_surface.default.hex}}"
    frame_color = "{{colors.primary.default.hex}}"
    default_icon = dialog-information


[urgency_normal]
    timeout = 6
    background = "{{colors.surface_container.default.hex}}"
    foreground = "{{colors.on_surface.default.hex}}"
    frame_color = "{{colors.primary.default.hex}}"
    default_icon = dialog-information


[urgency_critical]
    timeout = 0
    background = "{{colors.error_container.default.hex}}"
    foreground = "{{colors.on_error_container.default.hex}}"
    frame_color = "{{colors.error.default.hex}}"
    default_icon = dialog-warning
