{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/larp.txt",
        "padding": {
            "top": 3,
            "right": 5
        }
    },

    "display": {
        "separator": "  "
    },

    "modules": [
        {
            "type": "title",
            "format": "{user-name}@{host-name}"
        },

        "separator",

        {
            "type": "os",
            "key": " OS"
        },

        {
            "type": "kernel",
            "key": "󰌽 Kernel"
        },

        {
            "type": "uptime",
            "key": "󰅐 Uptime"
        },

        {
            "type": "packages",
            "key": "󰏖 Packages"
        },

        {
            "type": "shell",
            "key": "󰆍 Shell"
        },

        {
            "type": "wm",
            "key": "󰖯 WM"
        },

        {
            "type": "terminal",
            "key": "󰆍 Terminal"
        },

        {
            "type": "cpu",
            "key": "󰻠 CPU"
        },

        {
            "type": "gpu",
            "key": "󰢮 GPU"
        },

        {
            "type": "memory",
            "key": "󰍛 Memory"
        },

        "separator",

        "colors"
    ]
}
